# Обов'язково в продакшені: довгий випадковий рядок.
# Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# production — вмикає Secure-cookie і забороняє запуск без SECRET_KEY
TUSOVKA_ENV=development

# Шлях до файлу SQLite і теки для обкладинок (за замовчуванням ./instance)
DATABASE_PATH=instance/tusovka.db
UPLOAD_DIR=instance/uploads

# Часовий пояс, у якому користувачі вводять дату події
APP_TIMEZONE=Europe/Kyiv

# Кількість проксі перед застосунком (1 для Render/Fly/nginx), щоб правильно бачити IP клієнта
TRUSTED_PROXIES=0

PORT=8000
